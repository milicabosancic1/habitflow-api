# Kopiraj u .env i popuni. NE commit-uj .env!
DB_URL=jdbc:postgresql://localhost:5432/habitflow
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=zameni-ovo-dugackom-nasumicnom-tajnom-od-bar-32-karaktera
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_SECONDS=60
# Web OAuth Client ID iz Google Cloud Console (ne Android client ID)
GOOGLE_CLIENT_ID=tvoj-client-id.apps.googleusercontent.com
# Anthropic Claude API kljuc za AI nedeljni uvid (POST /api/ai/weekly-insight).
# Opciono - ako nije postavljen, endpoint vraca 502 a Android tiho koristi fallback tekst.
ANTHROPIC_API_KEY=tvoj-anthropic-api-kljuc
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=9000
